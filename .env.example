# Schwab app credentials (from your Schwab developer portal)
SCHWAB_CLIENT_ID=your-schwab-client-id
SCHWAB_CLIENT_SECRET=your-schwab-client-secret

# Callback/redirect URL you configured in Schwab (must match exactly)
# If running locally without TLS, use http; if with TLS, use https.
SCHWAB_REDIRECT_URI=https://127.0.0.1:8000/accounts/callback

# First-time: get a refresh token via OAuth, then paste it here
SCHWAB_REFRESH_TOKEN=your-refresh-token

# Encrypted account hash from GET /trader/v1/accounts/accountNumbers, not the raw account number
SCHWAB_ACCOUNT_ID=your-encrypted-account-hash
# Base URL (keep default unless Schwab gives you a different sandbox URL)
SCHWAB_BASE_URL=https://api.schwabapi.com/v1

# Schwab has no sandbox for Individual Developer accounts (production only).
# When true, POST /orders/* calls Schwab's real previewOrder endpoint (validates,
# does not execute) instead of placing a live order. Set to false only when you
# intend to actually trade.
SCHWAB_DRY_RUN=true

# Live monitor loop (app/core/monitor.py): symbols to watch, how often to poll
# (seconds) while the market is open, and the max fraction of buying power a
# single BUY signal may spend (0.05 = 5%).
WATCHLIST_PATH=watchlist.json
MONITOR_POLL_SECONDS=60
SCHWAB_MAX_POSITION_PCT=0.05

# Extra risk controls (all optional, shown with their defaults):
# - max total value one symbol's position may reach (across repeated buys), as
#   a fraction of account value
SCHWAB_MAX_SYMBOL_EXPOSURE_PCT=0.15
# - force-sell a held position once it's down this fraction from average cost,
#   regardless of the ORB strategy's own tighter stop (blanket safety net)
SCHWAB_STOP_LOSS_PCT=0.10
# - pause new BUY/SELL trades (stop-loss still runs) once today's floating P&L
#   drops below this fraction of account value; resets the next trading day
SCHWAB_DAILY_LOSS_LIMIT_PCT=0.1
# - cumulative BUY $ submitted today can never exceed real buying power, even
#   if Schwab's balance hasn't caught up with an order just submitted (tracked
#   by the monitor itself). This fraction of account value can only tighten
#   that ceiling further, never loosen it past the real balance.
SCHWAB_MAX_DAILY_ORDER_VALUE_PCT=0.20

# ORB (Opening Range Breakout) strategy — see "stock trading strategy.md" for
# the full spec and README.md for what's implemented vs simplified. All
# optional, shown with their defaults:
SCHWAB_ORB_RISK_PCT=0.0015
SCHWAB_ORB_STOP_ATR_MULT=0.5
SCHWAB_ORB_RVOL_MIN=1.5
SCHWAB_ORB_SPREAD_MAX_PCT=0.0005
SCHWAB_ORB_OR_WIDTH_MIN_ATR=0.3
SCHWAB_ORB_OR_WIDTH_MAX_ATR=1.5
SCHWAB_ORB_MAX_TRADES_PER_SYMBOL=2
SCHWAB_ORB_MAX_CONSECUTIVE_LOSSES=3
SCHWAB_ORB_TIME_STOP_MINUTES=15
SCHWAB_ORB_TIME_STOP_R=0.5
SCHWAB_ORB_TARGET1_R=1.0
SCHWAB_ORB_TARGET2_R=1.5

# LINE risk notifications — see README's "LINE risk notifications" section for
# how to get these. Leave blank/unset to keep notifications disabled (safe no-op).
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_USER_ID=

# Database DSN. Leave unset to disable the daily price-history pipeline below
# (rest of the app is unaffected).
PG_DSN=postgresql://user:password@localhost:5432/dbname

# Daily price-history pipeline (app/core/data_pipeline.py): pulls today's top
# movers from these indices, backfills daily OHLCV bars into Postgres. All
# optional, shown with their defaults.
PRICE_HISTORY_MOVERS_INDICES=$DJI,$COMPX,$SPX
PRICE_HISTORY_MOVERS_SORT=VOLUME
PRICE_HISTORY_MOVERS_FREQUENCY=0
PRICE_HISTORY_BACKFILL_DAYS=60
# Time of day (ET) the daily job runs, after market close so the final daily
# bar is settled.
PRICE_HISTORY_RUN_TIME_ET=16:30
